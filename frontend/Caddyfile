141-147-98-57.sslip.io {
    # SSE (/events) wykluczone z kompresji - encode buforuje ramki,
    # co koliduje z natychmiastowym dostarczaniem eventów
    # (potwierdzony bug: caddyserver/caddy#6293).
    @notEvents {
        not path /events
    }
    encode @notEvents gzip zstd

    # API BitBudCoin
    @api path /info /state /events /blocks* /balance* /transactions* /pool* /solo* /network* /stats* /peers /swap* /htlc* /bridge* /miners* /mine* /transactions*
    reverse_proxy @api 127.0.0.1:5000 {
        flush_interval -1
    }

    # Pozostałe żądania również przekazujemy do Express,
    # dzięki czemu istniejące endpointy nie będą przypadkowo
    # kończyć się błędem Caddy.
    reverse_proxy 127.0.0.1:5000

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    log {
        output file /var/log/caddy/bitbudcoin-access.log
    }
}