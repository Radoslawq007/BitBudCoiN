  "addressFormat": {
    "prefix": "BbC",
    "body": "40 znaków hex = pierwsze 40 z SHA-256(klucz publiczny SPKI DER)",
    "regex": "^BbC[0-9a-fA-F]{40}$",
    "example": "BbCcbcfc6f043ddb1f5ac83dd59feab439e192a1fb7",
    "note": "Portfel WWW pokazuje wielkość liter jako sumę kontrolną; do sieci i podpisu idzie forma z małymi literami."
  },
